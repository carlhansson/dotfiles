#!/bin/bash
# Tell the application we are ready
echo "OK Pleased to meet you"

while read -r line; do
    # If the application requests the PIN/password
    if [[ "$line" == GETPIN* ]]; then
        # Fetch the password from Gnome Keyring
        PASSWORD=$(secret-tool lookup service bitwarden account carlhansson677@gmail.com)
        echo "D $PASSWORD"
        echo "OK"
    elif [[ "$line" == BYE* ]]; then
        echo "OK"
        exit 0
    else
        echo "OK"
    fi
done
